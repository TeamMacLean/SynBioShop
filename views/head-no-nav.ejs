<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <meta name="description" content="">
    <meta name="author" content="">

    <title>TSL SynBio</title>

    <link rel="stylesheet" type="text/css" href="/style/style.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.1/dropzone.min.css">

</head>

<body>
    <%# Data, not code: the JSON sits in its own non-executable block and is
        parsed from textContent. Interpolating it into a quoted JS string relied
        on every field having been HTML-escaped upstream first, which was both
        fragile and the reason names like O'Brien rendered mangled. %>
    <script type="application/json" id="signed-in-user"><%- jsonForScript(locals.signedInUser || null) %></script>
    <script>
        document.signedInUser = null;

        (function () {
            var el = document.getElementById('signed-in-user');
            if (!el) return;
            try {
                document.signedInUser = JSON.parse(el.textContent);
            } catch (e) {
                document.signedInUser = null;
            }
        })();
    </script>

    <% if (typeof locals !== 'undefined' && locals.billboard && locals.billboard.enabled && locals.billboard.text) { %>
        <div class="billboard">
            <div class="container">
                <p><%- locals.billboard.text %></p>
            </div>
        </div>
    <% } %>

    <%- include('flashes.ejs') %>
