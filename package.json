{
  "name": "synbioshop",
  "version": "1.1.0",
  "description": "TSL SynBio Shop",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synbioshop/notgeefu.git"
  },
  "keywords": [
    "synbio",
    "tsl"
  ],
  "author": "George Deeks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wookoouk/synbioshop/issues"
  },
  "homepage": "https://github.com/wookoouk/synbioshop#readme",
  "engines": {
    "node": ">=24.5.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:vpn": "VPN_MODE=true nodemon server.js",
    "budget-holders:check": "node scripts/checkBudgetHolderSource.js",
    "budget-holders:export": "node scripts/budgetHolderSnapshot.js export",
    "budget-holders:import": "node scripts/budgetHolderSnapshot.js import",
    "dev:budget:before": "NODE_ENV=development DEV_MODE=true VPN_MODE=false MAIL_TRANSPORT=memory DB_NAME=synbioshop_budget_demo BUDGET_HOLDER_REFRESH_ENABLED=false BUDGET_HOLDER_FIXTURE=before nodemon server.js",
    "dev:budget:after": "NODE_ENV=development DEV_MODE=true VPN_MODE=false MAIL_TRANSPORT=memory DB_NAME=synbioshop_budget_demo BUDGET_HOLDER_REFRESH_ENABLED=false BUDGET_HOLDER_FIXTURE=after nodemon server.js",
    "start-watch": "nodemon server.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build-watch": "webpack --mode development --watch",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:unit": "mocha --ignore 'test/integration/**' --ignore 'test/browser/**'",
    "test:integration": "mocha --ignore 'test/unit/**' --ignore 'test/browser/**'",
    "test:browser": "mocha --ignore 'test/unit/**' --ignore 'test/integration/**'",
    "test:budget:browser:install": "PLAYWRIGHT_BROWSERS_PATH=./test/.tmp/playwright playwright install chromium --only-shell",
    "test:budget:browser": "PLAYWRIGHT_CHANNEL= PLAYWRIGHT_BROWSERS_PATH=./test/.tmp/playwright DB_HOST=127.0.0.1 VPN_MODE=false TEST_DB_NAME=synbioshop_budget_browser_test mocha --no-config --require test/helpers/setup.js --timeout 30000 --exit test/browser/budgetHolders.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html mocha",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "csv": "^6.4.1",
    "csv-stringify": "^6.6.0",
    "dropzone": "5.9.3",
    "ejs": "^3.1.10",
    "email-templates": "^12.0.3",
    "express": "^4.21.2",
    "express-flash": "^0.0.2",
    "express-session": "^1.18.2",
    "express-session-rethinkdb": "^0.4.0",
    "inputmask": "^5.0.9",
    "ldapjs": "^3.0.7",
    "less": "^4.2.2",
    "less-middleware": "^2.2.1",
    "micromodal": "^0.6.1",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "normalize.css": "^8.0.1",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "passport-local": "^1.0.0",
    "proxy-from-env": "^1.1.0",
    "rethinkdbdash": "^2.3.31",
    "socket.io": "^4.8.1",
    "validator": "^13.15.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "babel-loader": "^9.2.1",
    "c8": "^10.1.3",
    "chai": "^5.1.2",
    "css-loader": "^7.1.2",
    "ejs-lint": "^2.0.0",
    "elegant-icons": "^0.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jquery": "^3.7.1",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.9",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^19.0.2",
    "socket.io-client": "^4.8.3",
    "style-loader": "^4.0.0",
    "supertest": "^7.0.0",
    "tinymce": "^7.6.0",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  }
}
